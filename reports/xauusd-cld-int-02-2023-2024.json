{
  "mode": "BACKTEST",
  "strategy": {
    "strategy_code": "CLD-INT-02-v1",
    "source": "CLD",
    "style": "INT",
    "name": "Session Breakout",
    "version_state": "FROZEN",
    "experimental": false,
    "implementation": "session_breakout_v1",
    "pair": "XAUUSD",
    "entry_timeframe": "M15",
    "trend_timeframe": "H1",
    "trend": {
      "type": "price_vs_ema",
      "ema_period": 200
    },
    "setup": {
      "type": "asian_range_breakout",
      "asian_range_utc": {
        "start": "00:00",
        "end_exclusive": "07:00"
      },
      "require_close_outside": true,
      "trigger_session": "London open"
    },
    "stop": {
      "type": "opposite_range_side_or_atr",
      "atr_period": 14,
      "atr_multiple": 1.5,
      "use_atr_if_range_wider": true
    },
    "take_profit_r": [
      1,
      2
    ],
    "expiry_minutes": 360,
    "max_signals_per_utc_day": 2,
    "session_filter": {
      "London open": {
        "timezone": "Europe/London",
        "start_hour": 8,
        "end_hour": 10
      }
    },
    "news_filter": {
      "minutes_before": 30,
      "minutes_after": 30,
      "impact": [
        "HIGH"
      ],
      "currencies": [
        "USD",
        "XAU"
      ]
    },
    "spread_filter": {
      "max_spread_price": "0.50",
      "max_age_seconds": 300
    },
    "price_tick": "0.01",
    "execution": {
      "method": "bid_ohlc_v1",
      "timeframe": "M1",
      "spread_price": "0.30",
      "slippage_price_per_fill": "0.05",
      "tp1_fraction": "0.50"
    },
    "public_rules": [
      "Build the Asian high/low from all 28 closed M15 candles between 00:00 and 07:00 UTC.",
      "Between 08:00 and 10:00 London time on weekdays, use a closed M15 move from inside to strictly outside of the range, in the direction of closed H1 price versus EMA200.",
      "Enter at the breakout close. The stop is the opposite range boundary unless it is farther than 1.5\u00d7 ATR(14), in which case use the ATR distance. An intrabar test without a breakout can produce PREPARE only."
    ]
  },
  "data_source": "HISTDATA_ASCII_M1_BID",
